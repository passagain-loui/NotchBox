<Window
    x:Class="NotchBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NotchBox v0.6.1">

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          DragLeave="RootGrid_DragLeave"
          Drop="RootGrid_Drop"
          Background="Transparent">

        <Border x:Name="NotchCard"
                Height="48"
                Margin="4,0,4,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="#EE0F172A"
                CornerRadius="0,0,18,18"
                BorderBrush="#33FFFFFF"
                BorderThickness="1,0,1,1">

            <Grid Padding="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot"
                         Grid.Column="0"
                         Width="8"
                         Height="8"
                         Margin="0,0,12,0"
                         Fill="#00E5FF" />

                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="Drop files here"
                           Foreground="#D1D5DB"
                           FontSize="13"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />

                <Border x:Name="DropBadge"
                        Grid.Column="2"
                        Background="#1E293B"
                        CornerRadius="10"
                        Padding="10,4,10,4"
                        BorderBrush="#475569"
                        BorderThickness="1">
                    <TextBlock x:Name="BadgeText"
                               Text="Shelf"
                               Foreground="#94A3B8"
                               FontSize="11"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
