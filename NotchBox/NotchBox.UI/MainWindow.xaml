<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotchBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NotchBox v0.5.1">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Top-Center Floating Notch Container -->
    <Grid Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,0">
        <Border x:Name="NotchBorder"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,16,16"
                Width="420"
                Height="54"
                Padding="16,8"
                PointerEntered="NotchBorder_PointerEntered"
                PointerExited="NotchBorder_PointerExited">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Indicator -->
                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#00F0FF" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Title / Drag Area -->
                <TextBlock Grid.Column="1" Text="NotchBox // Ghost Sync Active" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center"/>

                <!-- Action Button / Drop Indicator -->
                <Border Grid.Column="2" Background="#27272A" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="DROP ZONE" FontSize="10" FontWeight="Bold" Foreground="#00F0FF"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
