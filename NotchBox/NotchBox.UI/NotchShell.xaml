<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotchBox.UI.NotchShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NotchBox">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop">

        <Border x:Name="PillBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#EE0F0F0F"
                CornerRadius="0,0,16,16"
                Width="180"
                Height="32"
                Margin="0,8,0,0">
            <Border.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Border.Transitions>

            <StackPanel x:Name="ContentStack"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <Ellipse x:Name="StatusDot"
                         Width="8"
                         Height="8"
                         Fill="#FF00FF66"/>
                <TextBlock x:Name="BrandingText"
                           Text="NotchBox"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
